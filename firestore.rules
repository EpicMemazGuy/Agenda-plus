rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserCloudSettings(s) {
      return s is map &&
             s.keys().hasAll([
               'appThemeStyle', 'darkModePreference', 'agendaStyle', 'uiScale',
               'eloUrl', 'savedBusLine', 'uitvalNotificationsEnabled',
               'gradeNotificationsEnabled', 'testNotificationsEnabled',
               'quietHoursEnabled', 'quietHoursStartMinutes', 'quietHoursEndMinutes',
               'mutedSubjects', 'smartBusAlertsEnabled', 'busWalkMinutes',
               'busArrivalBufferMinutes', 'gradeUnboxingEnabled', 'gradeUnboxingMode'
             ]) &&
             s.keys().hasOnly([
               'appThemeStyle', 'darkModePreference', 'agendaStyle', 'uiScale',
               'eloUrl', 'savedBusLine', 'uitvalNotificationsEnabled',
               'gradeNotificationsEnabled', 'testNotificationsEnabled',
               'quietHoursEnabled', 'quietHoursStartMinutes', 'quietHoursEndMinutes',
               'mutedSubjects', 'smartBusAlertsEnabled', 'busWalkMinutes',
               'busArrivalBufferMinutes', 'gradeUnboxingEnabled', 'gradeUnboxingMode'
             ]) &&
             s.appThemeStyle in ['STANDARD', 'NOTHING_OS', 'ONE_UI'] &&
             s.darkModePreference in ['SYSTEM', 'LIGHT', 'DARK'] &&
             s.agendaStyle in ['COMPACT', 'SPACIOUS'] &&
             s.uiScale is number && s.uiScale >= 0.85 && s.uiScale <= 1.20 &&
             s.eloUrl is string && s.eloUrl.size() <= 500 &&
             s.savedBusLine is string && s.savedBusLine.size() <= 32 &&
             s.uitvalNotificationsEnabled is bool &&
             s.gradeNotificationsEnabled is bool &&
             s.testNotificationsEnabled is bool &&
             s.quietHoursEnabled is bool &&
             s.quietHoursStartMinutes is int && s.quietHoursStartMinutes >= 0 && s.quietHoursStartMinutes <= 1439 &&
             s.quietHoursEndMinutes is int && s.quietHoursEndMinutes >= 0 && s.quietHoursEndMinutes <= 1439 &&
             s.mutedSubjects is list && s.mutedSubjects.size() <= 50 &&
             (s.mutedSubjects.size() == 0 || (s.mutedSubjects[0] is string && s.mutedSubjects[0].size() <= 100)) &&
             s.smartBusAlertsEnabled is bool &&
             s.busWalkMinutes is int && s.busWalkMinutes >= 1 && s.busWalkMinutes <= 30 &&
             s.busArrivalBufferMinutes is int && s.busArrivalBufferMinutes >= 2 && s.busArrivalBufferMinutes <= 30 &&
             s.gradeUnboxingEnabled is bool &&
             s.gradeUnboxingMode in ['CASE_OPENING', 'TAP_IT_UP', 'PENALTIES', 'ULTIMATE_GRADE', 'PLINKO_DROP'];
    }

    function isValidUserCloudProfile(data) {
      return data.uid is string && data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 120 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 254)) &&
             (!('studentName' in data) || (data.studentName is string && data.studentName.size() <= 120)) &&
             (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 64)) &&
             (!('studentClass' in data) || (data.studentClass is string && data.studentClass.size() <= 64)) &&
             (!('personId' in data) || (data.personId is int && data.personId >= 0)) &&
             (!('schoolId' in data) || (data.schoolId is string && data.schoolId.size() <= 64)) &&
             (!('schoolName' in data) || (data.schoolName is string && data.schoolName.size() <= 150)) &&
             (!('schoolCity' in data) || (data.schoolCity is string && data.schoolCity.size() <= 100)) &&
             (!('schoolSubdomain' in data) || (data.schoolSubdomain is string && data.schoolSubdomain.size() <= 100)) &&
             (!('schoolProvider' in data) || data.schoolProvider in ['MAGISTER']) &&
             (!('magisterAccessToken' in data) || (data.magisterAccessToken is string && data.magisterAccessToken.size() <= 8192)) &&
             (!('magisterRefreshToken' in data) || (data.magisterRefreshToken is string && data.magisterRefreshToken.size() <= 8192)) &&
             data.magisterAuthenticated is bool &&
             isValidUserCloudSettings(data.settings);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'uid', 'displayName', 'magisterAuthenticated', 'settings', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'uid', 'email', 'displayName',
                         'studentName', 'studentId', 'studentClass', 'personId',
                         'schoolId', 'schoolName', 'schoolCity', 'schoolSubdomain', 'schoolProvider',
                         'magisterAccessToken', 'magisterRefreshToken', 'magisterAuthenticated',
                         'settings', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserCloudProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserCloudProfile(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'email', 'displayName',
                         'studentName', 'studentId', 'studentClass', 'personId',
                         'schoolId', 'schoolName', 'schoolCity', 'schoolSubdomain', 'schoolProvider',
                         'magisterAccessToken', 'magisterRefreshToken', 'magisterAuthenticated',
                         'settings', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
